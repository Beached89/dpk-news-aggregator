# Copy to .env and adjust as needed. All values have sensible defaults.

# Languages to scrape (comma-separated). Korean + English.
KCNA_LANGS=kp,en

# Minutes between scrape passes in --loop mode.
SCRAPE_INTERVAL_MIN=60

# Seconds to wait between requests (be polite to the slow origin).
REQUEST_DELAY=2.0

# Max articles fetched per pass.
MAX_ARTICLES_PER_RUN=60

# Only mirror content newer than this many hours; older is skipped and hidden.
MAX_AGE_HOURS=48

# Per-site scraper switches (1=on, 0=off). KCNA off for now while testing Rodong.
SCRAPE_KCNA=0
SCRAPE_RODONG=1

# Self-translation for Rodong (KO->EN). Rodong is scraped Korean-only (photo
# articles); the English is generated by us. Default provider is the bundled,
# self-hosted LibreTranslate container — no account or API key required.
TRANSLATE_PROVIDER=libretranslate
TRANSLATE_API_URL=http://libretranslate:5000/translate
TRANSLATE_API_KEY=
TRANSLATE_TARGET=EN-US
TRANSLATE_TIMEOUT=60
# Cloud alternative: set TRANSLATE_PROVIDER=deepl (or google), add a key, and
# clear TRANSLATE_API_URL. DeepL Free keys end in ":fx".
