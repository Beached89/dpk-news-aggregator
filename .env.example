# Copy to .env and adjust as needed. All values have sensible defaults.

# Languages to scrape (comma-separated). Korean + English.
KCNA_LANGS=kp,en

# Minutes between scrape passes in --loop mode.
SCRAPE_INTERVAL_MIN=60

# Seconds to wait between requests (be polite to the slow origin).
REQUEST_DELAY=2.0

# Max articles fetched per pass.
MAX_ARTICLES_PER_RUN=60

# Only mirror content newer than this many hours; older is skipped and hidden.
MAX_AGE_HOURS=48

# --- Placeholder cover art --------------------------------------------------
# Cards for stories the source has no photo for draw from the committed pool in
# assets/placeholders/. The pick is keyed on the story id so it stays put between
# runs; set a different salt to re-roll every assignment at once (e.g. after
# refreshing the pool). The workflow does not export this, so CI uses the default;
# add it to the publish step of scrape.yml if you want to re-roll there.
# Refresh or review the pool locally: python -m app.placeholders
PLACEHOLDER_SALT=

# Per-site scraper switches (1=on, 0=off). KCNA off for now while testing Rodong.
SCRAPE_KCNA=0
SCRAPE_RODONG=1

# --- Translation (KO -> EN) -------------------------------------------------
# The scheduled pipeline lives in .github/workflows/scrape.yml and runs on GitHub
# Actions; this file is only for running the pipeline on your own machine.
#
# Provider menu:
#   google_free     keyless public Google endpoint, batched, no account. Unofficial:
#                   Google can rate-limit or change it, so it is a mirror-grade
#                   default, not a contract. Best for running with no setup.
#   deepl           official API, free tier = 500k characters/month, key required
#                   (free keys end in ":fx"). Recommended if the site is public.
#   google          Google Cloud Translation v2, key required, paid after credits.
#   libretranslate  a LibreTranslate instance you host, set TRANSLATE_API_URL.
TRANSLATE_PROVIDER=google_free
TRANSLATE_API_KEY=
TRANSLATE_API_URL=
TRANSLATE_TARGET=EN-US
TRANSLATE_TIMEOUT=60

# Sentences already translated are never requested again. This file is what makes
# the free tiers last; keep it alongside the database (the workflow stores both in
# Cloudflare R2 between runs).
TRANSLATION_CACHE_PATH=./data/translations.json
TRANSLATION_CACHE_MAX=100000

# A sentence the provider cannot translate comes back empty so the site shows it as
# untranslated. Set to 1 to restore the old behaviour of leaving the Korean there
# (which reads as if it were an English translation).
TRANSLATE_KEEP_SOURCE_ON_FAIL=0

